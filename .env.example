# ============================================================
# AI APIs (Free tiers available)
# ============================================================

# Google Gemini (FREE tier: 15 req/min)
# Get from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_key_here

# OpenAI (Optional - paid)
OPENAI_API_KEY=

# ============================================================
# Visual Assets (All FREE)
# ============================================================

# Pexels (FREE: 200 req/hour)
# Get from: https://www.pexels.com/api/
PEXELS_API_KEY=your_pexels_key_here

# Pixabay (FREE: 100 req/min)
# Get from: https://pixabay.com/api/docs/
PIXABAY_API_KEY=

# Unsplash (FREE: 50 req/hour)
# Get from: https://unsplash.com/developers
UNSPLASH_API_KEY=

# Giphy (FREE: 42 req/hour)
# Get from: https://developers.giphy.com/
GIPHY_API_KEY=

# ============================================================
# YouTube Upload
# ============================================================

# Get from: https://console.cloud.google.com/
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=

# ============================================================
# Ollama (Optional - Local AI)
# ============================================================

OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=llama3.1:8b

# ============================================================
# Config
# ============================================================

LOG_LEVEL=INFO
